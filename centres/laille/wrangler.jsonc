// Config Cloudflare du centre. CIS Laillé : production.
// Les chemins partent de ce dossier vers l'appli compilée.
{
	"$schema": "../../apps/web/node_modules/wrangler/config-schema.json",
	"name": "gyro-caserne-laille",
	"main": "../../apps/web/.svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	// Production, données réelles : jamais d’adresse de prévisualisation d’une version.
	"preview_urls": false,
	// Adresse de la production (déduite du sous-domaine cis-laille du compte, à confirmer avant le premier tag) : les liens de connexion pointent vers elle. En clair, ce n’est pas un secret (décision 0024) ; en local, .dev.vars l’emporte.
	"vars": { "BETTER_AUTH_URL": "https://gyro-caserne-laille.cis-laille.workers.dev" },
	"assets": { "binding": "ASSETS", "directory": "../../apps/web/.svelte-kit/cloudflare" },
	// Chaque nuit à 3 h 30 (UTC), les vieux messages et notifications sont effacés ; toutes les dix minutes (décision 0012), les notifications restées en file partent au téléphone (elles partent d’habitude dès le geste qui les crée), la météo, les remplacements, les annonces de 8 h.
	"triggers": { "crons": ["30 3 * * *", "*/10 * * * *"] },
	// Bases créées le 12/11/2026 dans l’Union européenne (--jurisdiction eu).
	"d1_databases": [
		{
			"binding": "BASE",
			"database_name": "gyro-caserne-laille",
			"database_id": "79084104-51fa-49f8-b7e3-14cf67b7ae2a",
			"migrations_dir": "../../packages/socle/migrations"
		},
		// Base des photos (décision 0010).
		{
			"binding": "PHOTOS",
			"database_name": "gyro-caserne-laille-photos",
			"database_id": "93af4244-2071-4334-a2a0-dcadfd14710f",
			"migrations_dir": "../../packages/socle/migrations-photos"
		}
	]
	// Les photos sont dans une base D1 à part, pas dans R2 : voir docs/decisions/0010-photos-dans-leur-base.md.
}
