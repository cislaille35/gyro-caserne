// Config Cloudflare du centre. Centre fictif : préprod et démonstration, données fictives uniquement.
// Les chemins partent de ce dossier vers l'appli compilée.
{
	"$schema": "../../apps/web/node_modules/wrangler/config-schema.json",
	"name": "gyro-caserne-exemple",
	"main": "../../apps/web/.svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	// Plus de version d’essai en ligne depuis la fin de la refonte (décision 0022) : chaque déploiement coupe les adresses de prévisualisation, dont refonte-gyro-caserne-exemple. À remettre à true le jour où on en a besoin.
	"preview_urls": false,
	"assets": { "binding": "ASSETS", "directory": "../../apps/web/.svelte-kit/cloudflare" },
	// Chaque nuit à 3 h 30 (UTC), les vieux messages et notifications sont effacés ; toutes les cinq minutes, les notifications restées en file partent au téléphone (elles partent d’habitude dès le geste qui les crée), la météo, les remplacements, les annonces de 8 h.
	"triggers": { "crons": ["30 3 * * *", "*/5 * * * *"] },
	// Base de la préprod du CIS Laillé : un autre centre remplace ce database_id par celui de sa base.
	"d1_databases": [
		{
			"binding": "BASE",
			"database_name": "gyro-caserne-exemple",
			"database_id": "4023bc60-3007-494d-9c7a-68e0af29c927",
			"migrations_dir": "../../packages/socle/migrations"
		},
		// Base des photos de la préprod (décision 0010) : un autre centre remplace aussi ce database_id.
		{
			"binding": "PHOTOS",
			"database_name": "gyro-caserne-exemple-photos",
			"database_id": "f641719a-76fa-45c1-8664-07ed7dd2b891",
			"migrations_dir": "../../packages/socle/migrations-photos"
		}
	]
	// Les photos sont dans une base D1 à part, pas dans R2 : voir docs/decisions/0010-photos-dans-leur-base.md.
}
