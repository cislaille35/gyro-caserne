// Config Cloudflare du centre. Centre fictif : préprod et démonstration, données fictives uniquement.
// Les chemins partent de ce dossier vers l'appli compilée.
{
	"$schema": "../../apps/web/node_modules/wrangler/config-schema.json",
	"name": "gyro-caserne-exemple",
	"main": "../../apps/web/.svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	// Pas de version d’essai en ligne : chaque déploiement coupe les adresses de prévisualisation (décisions 0022, 0026).
	"preview_urls": false,
	// Adresse de la préprod : les liens de connexion pointent vers elle. En clair, ce n’est pas un secret (décision 0024) ; en local, .dev.vars l’emporte.
	// JOURNAL_DES_PAGES : l'appli écrit au journal le nom générique de chaque page (décision 0037). Seulement avec le journal des requêtes ci-dessous.
	"vars": { "BETTER_AUTH_URL": "https://gyro-caserne-exemple.cis-laille.workers.dev", "JOURNAL_DES_PAGES": true },
	"assets": { "binding": "ASSETS", "directory": "../../apps/web/.svelte-kit/cloudflare" },
	// Journal de Cloudflare (Workers Logs, décision 0036) : gardé 3 jours (7 à partir du 1er décembre 2026), peut-être hors de l'Union européenne.
	// Préprod aux données fictives : tout est gardé, chaque requête comprise, les traces et la détection des problèmes (issues), pour que le relevé
	// quotidien nomme coupures et erreurs par page. Un centre aux données réelles coupe tout, comme centres/laille (voir docs/technique/journal.md).
	"observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": true }, "traces": { "enabled": true, "head_sampling_rate": 1 }, "issues": { "enabled": true } },
	// Chaque nuit à 3 h 30 (UTC), les vieux messages et notifications sont effacés ; toutes les dix minutes (décision 0012), les notifications restées en file partent au téléphone (elles partent d’habitude dès le geste qui les crée), la météo, les remplacements, les annonces de 8 h.
	"triggers": { "crons": ["30 3 * * *", "*/10 * * * *"] },
	// Base de la préprod du CIS Laillé : un autre centre remplace ce database_id par celui de sa base.
	"d1_databases": [
		{
			"binding": "BASE",
			"database_name": "gyro-caserne-exemple",
			"database_id": "4023bc60-3007-494d-9c7a-68e0af29c927",
			"migrations_dir": "../../packages/socle/migrations"
		},
		// Base des photos de la préprod (décision 0010) : un autre centre remplace aussi ce database_id.
		{
			"binding": "PHOTOS",
			"database_name": "gyro-caserne-exemple-photos",
			"database_id": "f641719a-76fa-45c1-8664-07ed7dd2b891",
			"migrations_dir": "../../packages/socle/migrations-photos"
		}
	]
	// Les photos sont dans une base D1 à part, pas dans R2 : voir docs/decisions/0010-photos-dans-leur-base.md.
}
