// Configuration Cloudflare Workers. Chaque centre déploie sa propre copie, sur son propre compte Cloudflare.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gyro-caserne",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" }
	// La base D1 et le stockage R2 des photos s'ajouteront ici avec les premières fonctions.
}
