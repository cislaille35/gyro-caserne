{
  "name": "@gyro-caserne/web",
  "version": "0.0.0",
  "private": true,
  "description": "L'appli Gyro Caserne (PWA) : SvelteKit sur Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev --config ../../centres/${CENTRE:-exemple}/wrangler.jsonc",
    "deployer": "vite build && wrangler deploy --config ../../centres/${CENTRE:-exemple}/wrangler.jsonc",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gyro-caserne/centre": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
